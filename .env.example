# =========================================================================
# FixIt AI — variables d'environnement (exemple)
# Copier en .env / .dev.vars et NE JAMAIS committer les vraies valeurs.
# Les secrets ci-dessous vivent UNIQUEMENT côté serveur (Cloudflare Worker).
# =========================================================================

# ----- apps/api  (Cloudflare Worker : wrangler secret put / .dev.vars) -----

# IA — Google Gemini (clé fournie par l'utilisateur, gratuite)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Providers optionnels (non implémentés au MVP)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Base de données — Neon (PostgreSQL serverless)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Auth (à confirmer — Neon Auth)
AUTH_JWT_SECRET=
NEON_AUTH_PROJECT_ID=
NEON_AUTH_JWKS_URL=

# Stockage images — Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fixit-ai-images
R2_PUBLIC_BASE_URL=

# Quotas / plan gratuit
FREE_MONTHLY_DIAGNOSES=3

# Divers
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:8081,exp://

# ----- apps/mobile  (Expo : app.config.ts -> extra, préfixe EXPO_PUBLIC_) -----
# UNIQUEMENT des valeurs publiques ici. Aucune clé secrète.

EXPO_PUBLIC_API_BASE_URL=http://localhost:8788
EXPO_PUBLIC_APP_ENV=development
