# =========================================================================
# FixIt AI — variables d'environnement (exemple)
# Copier en apps/api/.dev.vars et NE JAMAIS committer les vraies valeurs.
# Les SECRETS vivent uniquement côté serveur (Cloudflare Worker).
# =========================================================================

# ----- apps/api/.dev.vars  (SECRETS — wrangler secret put en prod) --------

# IA — Google Gemini (clé gratuite fournie par l'utilisateur)
GEMINI_API_KEY=
# Base de données — Neon (chaîne de connexion "pooler")
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ----- apps/api/wrangler.toml [vars]  (publiques, déjà committées) --------
#   APP_ENV, FREE_MONTHLY_DIAGNOSES, GEMINI_MODEL=gemini-3.6-flash
#   STACK_PROJECT_ID, STACK_JWKS_URL, STACK_PUBLISHABLE_KEY  (Neon Auth / Stack)
#   [[r2_buckets]] binding=IMAGES bucket_name=fixit-ai-images

# ----- Déploiement (à faire une fois) -----------------------------------
#   wrangler login
#   wrangler r2 bucket create fixit-ai-images
#   wrangler secret put GEMINI_API_KEY
#   wrangler secret put DATABASE_URL

# ----- apps/mobile  (Expo : app.config.ts -> extra, préfixe EXPO_PUBLIC_) -
# UNIQUEMENT des valeurs publiques. Aucune clé secrète.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8788
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_STACK_PROJECT_ID=3432abc2-2b77-4b7b-acff-0686a7b99697
EXPO_PUBLIC_STACK_PUBLISHABLE_KEY=pck_...
